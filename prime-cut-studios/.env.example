# Self-hosted local/server config. NEVER commit .env.local or database files.
# Required for staff sign-in. Generate hash with: node scripts/generate-admin-hash.cjs "long unique password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Generate: openssl rand -base64 48
SESSION_SECRET=
# Persistent PRIVATE volume path on your own server (not ephemeral hosting).
PRIMECUTS_DB_PATH=./data/primecuts.sqlite
# Leave empty until the real public domain is approved.
NEXT_PUBLIC_SITE_URL=
# Drive folder references for the future authenticated connector workflow; NOT a live sync.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_CLIENTS_FOLDER_ID=
GOOGLE_DRIVE_DELIVERY_FOLDER_ID=
GOOGLE_DRIVE_TEMPLATES_FOLDER_ID=
PRIMECUTS_MEDIA_PATH=./data/portfolio
