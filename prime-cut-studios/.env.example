# Prime Cut Studios v0.3 — Supabase configuration (server-only).
# Do not commit .env.local to GitHub; configure these in Vercel Environment Variables.
SUPABASE_URL=https://mvrszgunjwvdqogtpyqm.supabase.co
# Supabase > BBHUB > Project Settings > API Keys > Secret key (sb_secret_...). Server only.
SUPABASE_SECRET_KEY=

# Admin login: choose your own email and hashed password. Generate hash locally:
# node scripts/generate-admin-hash.cjs "your-long-unique-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# 32+ random bytes; e.g., openssl rand -base64 48
SESSION_SECRET=

# Only set the public URL once the site is actually live.
NEXT_PUBLIC_SITE_URL=
# Drive links are NOT synced automatically. Add any IDs only in server-side environment variables.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_CLIENTS_FOLDER_ID=
GOOGLE_DRIVE_DELIVERY_FOLDER_ID=
GOOGLE_DRIVE_TEMPLATES_FOLDER_ID=
